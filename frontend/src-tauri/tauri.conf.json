{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ELA Desktop",
  "mainBinaryName": "app",
  "version": "0.1.0",
  "identifier": "com.ela.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run prepare:desktop-runtime && npx cross-env VITE_CLIENT_MODE=desktop npm run dev -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "ELA Desktop",
        "width": 1440,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "resources": [
      "resources/desktop-runtime/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
