POSTGRES_DB=ela
POSTGRES_USER=ela_user
POSTGRES_PASSWORD=ela_pass
POSTGRES_PORT=5432
FRONTEND_PORT=8080
ELA_DATABASE_URL=postgresql://ela_user:ela_pass@postgres:5432/ela
ELA_DB_BACKEND=sqlite
ELA_SQLITE_DB_PATH=artifacts/backend_state.sqlite3
TORCH_VERSION=2.6.0

# Media limits (default profile: ~15 minutes, medium quality)
MEDIA_MAX_DURATION_MIN=15
MEDIA_MAX_SIZE_LOCAL_MB=250
MEDIA_MAX_SIZE_BACKEND_MB=2048

# Runtime policy: auto|offline|online (auto defaults to online)
ELA_RUNTIME_MODE=online
ELA_DEPLOYMENT_MODE=local
ELA_PHONETIC_POLICY=enabled
ELA_SENTENCE_CONTRACT_BACKEND_URL=http://127.0.0.1:8000
ELA_SENTENCE_CONTRACT_TIMEOUT_SEC=300
ELA_SENTENCE_CONTRACT_WARMUP=1
ELA_SENTENCE_CONTRACT_WARMUP_TEXT=She should have trusted her instincts before making the decision.
# Runtime sentence-contract defaults:
# - if ELA_CLASSIFIER_PROVIDER is empty: runtime picks `deberta` automatically when
#   artifacts/models/deberta_classifier_cefr exists, otherwise falls back to `rule`.
ELA_CLASSIFIER_PROVIDER=
ELA_CLASSIFIER_MODEL_PATH=
# Optional local T5 model for controlled blueprint rewrite.
# Set to the best_model subdirectory, e.g.:
#   ELA_CONTROLLED_T5_MODEL_DIR=artifacts/models/t5_notes_v18_contract_book_farlex_e15_lr3e4_base/best_model
# Docker path (inside container): /app/artifacts/models/t5_notes_v18_contract_book_farlex_e15_lr3e4_base/best_model
ELA_CONTROLLED_T5_MODEL_DIR=artifacts/models/t5_notes_v18_contract_book_farlex_e15_lr3e4_base/best_model
# Sentence notes policy:
# - default path: deterministic code fallback (no external LLM call)
# - ChatGPT path is optional and opt-in only
ELA_SENTENCE_NOTES_USE_CHATGPT=0
ELA_SENTENCE_NOTES_OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=...

# Optional translation cache for hot path: empty|memory|redis
ELA_TRANSLATION_CACHE_BACKEND=
ELA_TRANSLATION_CACHE_URL=
ELA_TRANSLATION_CACHE_TTL_SECONDS=86400

# Temporary media retention policy
MEDIA_TEMP_DIR=artifacts/media_tmp
MEDIA_RETENTION_TTL_HOURS=24

# Backend minimal identity policy (phone hash only; raw phone is not persisted)
ELA_PHONE_HASH_SALT=change_me_strong_salt
